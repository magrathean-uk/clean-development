#!/bin/sh
# clean-development 0.6.0 hook launcher: cd-hook <session-start|stop|session-end> <claude|codex>
# Finds Node from the installer, standard user installs or PATH. A missing runtime never fails the calling session.
rt="${0%/bin/cd-hook}"
node_ok() {
  [ -x "$1" ] && "$1" -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major < 20 || (major === 20 && minor < 12) ? 1 : 0)' >/dev/null 2>&1
}
for n in "${CLEAN_DEV_NODE:-}" "$HOME/dev/machine/toolchains/node/current/bin/node" "$HOME/.local/bin/node" /opt/homebrew/bin/node /usr/local/bin/node; do
  if [ -n "$n" ] && node_ok "$n"; then exec "$n" "$rt/bin/cd-hook.mjs" "$@"; fi
done
node=$(command -v node 2>/dev/null || true)
if [ -n "$node" ] && node_ok "$node"; then exec "$node" "$rt/bin/cd-hook.mjs" "$@"; fi
echo "clean-development hook: Node.js 20.12 or later not found; set CLEAN_DEV_NODE or install Node on PATH" >&2
exit 0
