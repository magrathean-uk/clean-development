#!/bin/sh
# Optional Clean Development Colima shim. Private source manifests may install it for configured hosts.
# Colima's own Lima instances live under $COLIMA_HOME/_lima; keep the inherited LIMA_HOME consistent.
if [ -z "${COLIMA_HOME:-}" ]; then
  echo "colima: set COLIMA_HOME to the configured VM home before using this shim" >&2
  exit 78
fi
if [ ! -d "${COLIMA_HOME%/*}" ]; then
  echo "colima: ${COLIMA_HOME%/*} is missing; Colima VMs require the configured VM storage" >&2
  exit 78
fi
self=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)
real=""
candidates="/opt/homebrew/bin/colima /usr/local/bin/colima"
if [ -n "${DEV_STORAGE_VOLUME_TEST:-}" ] && [ -n "${CLEAN_DEV_COLIMA:-}" ]; then candidates="$CLEAN_DEV_COLIMA"; fi # test mode only
for c in $candidates; do
  [ -x "$c" ] || continue
  [ "$c" -ef "$0" ] && continue
  d=$(CDPATH= cd -- "$(dirname -- "$c")" 2>/dev/null && pwd -P)
  [ "$d" = "$self" ] && continue
  head -c 512 "$c" 2>/dev/null | grep -Eiq 'optional clean[- ]development colima shim' && continue
  real=$c
  break
done
if [ -z "$real" ]; then
  echo "colima: the Homebrew colima binary was not found" >&2
  exit 127
fi
LIMA_HOME="$COLIMA_HOME/_lima"
export LIMA_HOME
exec "$real" "$@"
