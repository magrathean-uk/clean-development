{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/machine/runtime/clean-development/active/bin/cd-hook\" session-start claude",
            "timeout": 30,
            "statusMessage": "clean-development"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/machine/runtime/clean-development/active/bin/cd-hook\" stop claude",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/machine/runtime/clean-development/active/bin/cd-hook\" session-end claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
