{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "clean-development",
  "version": "0.2.1",
  "description": "Explicit management skill for configuring and inspecting clean-development.",
  "author": {
    "name": "Magrathean UK",
    "url": "https://github.com/magrathean-uk"
  },
  "homepage": "https://github.com/magrathean-uk/clean-development",
  "repository": "https://github.com/magrathean-uk/clean-development",
  "license": "MIT",
  "keywords": [
    "build-cache",
    "developer-tools",
    "ai-agent"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Clean Development",
        "shortDescription": "Managed developer caches and build output",
        "longDescription": "Preview, configure, inspect, and explicitly prune supported local development caches and build output. Requires Node.js 20.12 or later and a coding host with local command access.",
        "developerName": "Magrathean UK",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/magrathean-uk/clean-development",
        "defaultPrompt": [
          "Use Clean Development only when explicitly requested."
        ],
        "privacyPolicyURL": "https://github.com/magrathean-uk/clean-development/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/magrathean-uk/clean-development/blob/main/TERMS.md",
        "brandColor": "#122B35",
        "composerIcon": "./docs/assets/logo.png",
        "logo": "./docs/assets/logo.png"
      }
    }
  }
}
